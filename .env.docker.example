# Copy to .env before: docker compose up -d --build
# cp .env.docker.example .env

# --- Ollama (compose service "ollama") ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Pulled automatically on first start by docker/entrypoint.sh
OLLAMA_PUBLISH_PORT=11434

# --- Whisper (CPU; use cuda + GPU compose override for NVIDIA) ---
WHISPER_MODEL=base
WHISPER_LIVE_MODEL=tiny
WHISPER_FINAL_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Piper TTS ---
PIPER_VOICE=en_US-lessac-medium

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PUBLISH_PORT=8765
WEB_SSL_CERT=data/certs/web.crt
WEB_SSL_KEY=data/certs/web.key
WEB_CONVERSATION_SILENCE_SECONDS=3
WEB_LIVE_TRANSCRIBE_INTERVAL_SECONDS=2

# Desktop-only features disabled in Docker web mode
WAKEWORD_ENABLED=false

# --- Docker build/runtime ---
# Set PRELOAD_WHISPER=1 to bake Whisper models into the image (larger, faster first start)
PRELOAD_WHISPER=0
PRELOAD_PIPER=1

# --- TLS SAN for LAN mic (optional) ---
# Add your server LAN IP so phones trust the cert after import:
# WEB_CERT_SAN=DNS:localhost,DNS:voice-assistant,IP:127.0.0.1,IP:192.0.2.10
# WEB_CERT_CN=voice-assistant.local

# --- Cursor CLI (optional; mount host binary + workspace) ---
# CURSOR_WORKSPACE=/workspace
# CURSOR_MODEL=composer-2.5
# CURSOR_API_KEY=
# CURSOR_AGENT_BIN=cursor-agent

# --- PC control (disabled by default in container) ---
ALLOWED_APPS=
ALLOWED_COMMANDS=
ALLOWED_DIRECTORIES=
