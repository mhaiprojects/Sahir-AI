[Unit]
Description=Sahir voice assistant (wake word + PTT + Cursor CLI)
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
# The @ROOT@ placeholder is filled in by scripts/install_systemd.sh
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=WEB_AUTH_TOKEN_FILE=%h/.config/jahash-secrets/sahir-web-token.txt
ExecStartPre=-@ROOT@/scripts/wait_ollama.sh
ExecStart=@ROOT@/venv/bin/python bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target