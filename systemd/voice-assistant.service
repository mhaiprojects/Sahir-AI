[Unit]
Description=Voice Assistant (Wake Word + PTT + Cursor CLI)
After=network.target ollama.service graphical-session.target

[Service]
Type=simple
# The ROOT placeholder in paths below is filled in by scripts/install_systemd.sh
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=@ROOT@/venv/bin/python bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
