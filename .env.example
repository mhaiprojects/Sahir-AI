# Sahir (Sahir-AI) configuration. Copy to .env and adjust; never commit .env.
# Local pipeline
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Chat replies: ollama (default) or openai-compatible HTTP (e.g. llama-server -m … --port 8080)
# LLM_BACKEND=ollama
# LLM_BACKEND=openai
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_MODEL=your-gguf-model-id
# OPENAI_API_KEY=local-dev
# OPENAI_API_KEY_FILE=~/.config/jahash-secrets/openai-api-key.txt
# OPENAI_TIMEOUT_SECONDS=120
# Optional: override path shown on Models page (else read from systemctl show ollama)
# OLLAMA_MODELS_DIR=/mnt/ssd6/ollama/models
# OLLAMA_MODELS_WARN_FREE_GB=10
# Explicit num_ctx on every Sahir Ollama chat/generate call (issue #5)
OLLAMA_NUM_CTX=4096
# Keep nomic-embed-text on CPU so it does not steal VRAM from the router (issue #4)
EMBED_ON_CPU=true
# Pinned utterance-router model (warm classify hop); loaded at web server start
ROUTER_MODEL=qwen3:0.6b
ROUTER_NUM_CTX=1024
ROUTER_PIN_ENABLED=true
ROUTER_KEEP_WARM_SEC=120
ROUTER_T1_ENABLED=true
ROUTER_T1_MARGIN=0.07
ROUTER_T2_ENABLED=true
ROUTER_T2_TIMEOUT_MS=400
ROUTER_T2_CONFIDENCE=0.55
ROUTER_T2_FALLBACK=false
ROUTER_T2_FALLBACK_MODEL=qwen3:1.7b
# VRAM budget warnings on the Models page (RX 5500 class 4 GB defaults)
VRAM_TOTAL_GB=4
VRAM_ROUTER_GB=0.7
VRAM_EMBED_GB=0.3
VRAM_DESKTOP_GB=1.1
# Big model used when a small model returns an invalid action or you say "think harder" (docs/models.md)
FALLBACK_MODEL=llama3.1:8b
MODEL_KEEP_ALIVE=30m
WHISPER_MODEL=base
WHISPER_LIVE_MODEL=tiny
WHISPER_FINAL_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_PATH=

# Activation
# Wake word: hey_jarvis until a custom "Hey Sahir" openWakeWord model is trained (planned)
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_ENABLED=true
# Desktop wake: openwakeword (default) or sherpa-onnx kws (custom phrases, no training)
# WAKEWORD_ENGINE=openwakeword
# WAKEWORD_ENGINE=kws
# WAKE_PHRASES=hey sahir,okay sahir
# WAKE_KWS_THRESHOLD=0.25
# WAKE_KWS_SCORE=1.5
# WAKE_UTTERANCE_TIMEOUT_S=8
PTT_HOTKEY=ctrl_r

# Cursor CLI
CURSOR_WORKSPACE=~/path/to/your/workspace
CURSOR_MODEL=composer-2.5
CURSOR_API_KEY=
CURSOR_AGENT_BIN=cursor-agent
CURSOR_TIMEOUT_SECONDS=300
# Print-mode shell tools: --force when true (default). Set false to match strict ~/.cursor/cli-config.json allowlists.
CURSOR_AGENT_FORCE=true
# Optional: enabled | disabled (omit when empty) for cursor-agent --sandbox
# CURSOR_AGENT_SANDBOX=
# Non-interactive Auto-review classifier (default off; approvals still need --force or allow rules)
# CURSOR_AGENT_AUTO_REVIEW=false

# Web UI (LAN access)
WEB_HOST=0.0.0.0
WEB_PORT=8765
# Shared-secret login for the web UI (default on). Token lives in a file — run scripts/generate_web_token.sh
WEB_AUTH_ENABLED=true
WEB_AUTH_TOKEN_FILE=
# Do not put WEB_AUTH_TOKEN in this file; use the token file or env for scripts only.
WEB_DB_PATH=
# For microphone access from LAN devices (not localhost), enable HTTPS:
WEB_SSL_CERT=data/certs/web.crt
WEB_SSL_KEY=data/certs/web.key
WEB_CONVERSATION_SILENCE_SECONDS=3
WEB_LIVE_TRANSCRIBE_INTERVAL_SECONDS=2

# Wyoming protocol (optional Home Assistant / wyoming-satellite STT+TTS; separate from WEB_PORT)
# WYOMING_URI=tcp://127.0.0.1:10300
# WYOMING_ALLOW_LAN=false
# WYOMING_HANDLE_ENABLED=false
# WYOMING_MAX_AUDIO_SECONDS=30
# Docs: docs/integrations/wyoming.md

# PC control whitelists (comma-separated)
ALLOWED_APPS=firefox,cursor,code,thunar,xdg-open
ALLOWED_COMMANDS=df,free,uptime,ls,pactl
# Empty = your home directory. Use absolute paths, e.g. /home/you/projects
ALLOWED_DIRECTORIES=

# --- Local-first agent (chat history, memory, RAG) ---
AGENT_DB_PATH=
# Default mode for new chats (agent=orchestrator, route=tools router, chat/stream=plain model, cursor)
DEFAULT_CHAT_MODE=agent
EMBED_MODEL=nomic-embed-text
# --- Ollama *service* tuning for 4 GB AMD (Vulkan); set on the Ollama daemon, not only here ---
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
# LLAMA_ARG_FIT_TARGET=384
# Example (systemd user unit): mkdir -p ~/.config/systemd/user/ollama.service.d
#   printf '[Service]\nEnvironment=OLLAMA_FLASH_ATTENTION=1\nEnvironment=OLLAMA_KV_CACHE_TYPE=q8_0\nEnvironment=LLAMA_ARG_FIT_TARGET=384\n' > ~/.config/systemd/user/ollama.service.d/vram.conf
# Then: systemctl --user daemon-reload && systemctl --user restart ollama
# Sahir does not change the Ollama service; restart Ollama yourself after editing.
AGENT_HISTORY_TURNS=12
AGENT_AUTO_MEMORY=true
AGENT_PERSIST_WEB=true
AGENT_SESSION_IDLE_MINUTES=30
MEMORY_TOP_K=5
RAG_TOP_K=4
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MAX_UPLOAD_MB=25

# --- Voice loop / VAD ---
VAD_GATE_ENABLED=true
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_SECONDS=0.25
VOICE_END_SILENCE_MS=700

# --- TTS backend: piper (default) or kokoro (run scripts/setup_kokoro.sh) ---
TTS_BACKEND=piper
KOKORO_MODEL_DIR=
KOKORO_SPEAKER_ID=0
KOKORO_SPEED=1.0

# --- ClickUp (optional; worker outputs → tasks/comments/status/time) ---
# Personal API token from ClickUp → Settings → Apps → API Token (not committed).
CLICKUP_API_TOKEN=
# Default list id for create_task (from list URL or ?list_id= in ClickUp).
CLICKUP_LIST_ID=
# Optional workspace team id (auto-discovered when omitted).
CLICKUP_TEAM_ID=
# Alternative to CLICKUP_API_TOKEN: token file, chmod 600 (e.g. ~/.config/jahash-secrets/clickup-token.txt)
CLICKUP_TOKEN_FILE=

# --- Email (optional; IMAP read + SMTP send with confirmation) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SSL=false
EMAIL_USERNAME=
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_PASSWORD_FILE=
# Optional: append drafts to this IMAP folder (e.g. Drafts)
EMAIL_IMAP_DRAFTS_FOLDER=
# Optional: comma-separated allowed recipient addresses for send
EMAIL_SEND_ALLOWLIST=

# --- Calendar (optional; CalDAV write or ICS read-only URL) ---
CALENDAR_CALDAV_URL=
CALENDAR_ICS_URL=
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
CALENDAR_PASSWORD_FILE=
CALENDAR_NAME=
CALENDAR_TIMEZONE=Australia/Melbourne
